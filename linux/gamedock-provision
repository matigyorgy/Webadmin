#!/usr/bin/python3
"""Root-owned asynchronous template copier. Copies run as a pinned non-root game user."""
import base64
import fcntl
import hashlib
import importlib.machinery
import importlib.util
from pathlib import Path
import json
import os
import pwd
import re
import shutil
import stat
import subprocess
import sys
import tempfile

library=Path(__file__).resolve().parent/'gamedock_runtime.py'
if not library.is_file():library=Path('/usr/local/libexec/gamedock_runtime.py')
spec=importlib.util.spec_from_file_location('gamedock_runtime',library);runtime=importlib.util.module_from_spec(spec);spec.loader.exec_module(runtime)
CONFIG='/etc/gamedock/servers.json'
JOBS='/var/lib/gamedock/provision/jobs'
SELF='/usr/local/sbin/gamedock-provision'
GAMES=('minecraft','cs16','cs2','fivem','css')

def storage_module():
    path=Path(__file__).resolve().parent/'gamedock-storage'
    if not path.is_file():path=Path('/usr/local/sbin/gamedock-storage')
    loader=importlib.machinery.SourceFileLoader('provision_storage',str(path));spec=importlib.util.spec_from_loader(loader.name,loader);module=importlib.util.module_from_spec(spec);loader.exec_module(module);return module

def secure(path, directory=False):
    info=os.lstat(path)
    if info.st_uid!=0 or info.st_mode & (stat.S_IWGRP|stat.S_IWOTH) or stat.S_ISLNK(info.st_mode): raise ValueError('Unsafe root-owned path')
    if directory and not stat.S_ISDIR(info.st_mode): raise ValueError('Directory required')

def config():
    secure(os.path.dirname(CONFIG),True);secure(CONFIG)
    with open(CONFIG,encoding='utf-8') as stream:return json.load(stream)

def atomic(path,value):
    descriptor,temporary=tempfile.mkstemp(prefix='.gamedock-',dir=os.path.dirname(path))
    try:
        with os.fdopen(descriptor,'w',encoding='utf-8') as stream:
            json.dump(value,stream,ensure_ascii=False);stream.flush();os.fsync(stream.fileno())
        os.replace(temporary,path)
    finally:
        if os.path.exists(temporary):os.unlink(temporary)

def locked():
    secure(os.path.dirname(CONFIG),True)
    handle=open(CONFIG+'.lock','a')
    fcntl.flock(handle,fcntl.LOCK_EX)
    return handle

def job_path(job):
    if not isinstance(job,str) or not re.fullmatch(r'[a-f0-9]{32}',job):raise ValueError('Invalid job')
    return JOBS+'/'+job+'.json'

def read_job(job):
    with open(job_path(job),encoding='utf-8') as stream:value=json.load(stream)
    if value.get('state') in ('queued','running') and value.get('worker') and not runtime.alive(value['worker'],0):
        value.update(state='failed',message='A másolási folyamat megszakadt; újrapróbálható.');atomic(job_path(job),value)
    return value

def public(job):return {name:job[name] for name in ('state','message')}

def validate(payload,cfg):
    job_path(payload['job'])
    limit=payload.get('disk_limit_mb',0)
    if type(limit) is not int or not 0<=limit<=1073741824:raise ValueError('Invalid disk limit')
    unit=payload['unit'];game=payload['game'];folder=payload['folder'];source=payload['source']
    if not isinstance(unit,str) or not re.fullmatch(r'[A-Za-z0-9_][A-Za-z0-9_-]*(?:\.service)?',unit):raise ValueError('Invalid unit')
    if not isinstance(game,str) or not re.fullmatch(r'[a-z][a-z0-9_-]{0,31}',game) or not isinstance(folder,str) or not re.fullmatch(r'[a-zA-Z0-9_-]{1,120}',folder):raise ValueError('Invalid game/folder')
    policy=cfg['_provision'];source_root=os.path.realpath(policy['source_root']);target_root=os.path.realpath(policy['target_root'])
    secure(policy['source_root'],True);secure(policy['target_root'],True)
    # Root controls the roots; an administrator may select only a source below the source root.
    if not isinstance(source,str) or not os.path.isabs(source):raise ValueError('Absolute source required')
    source=os.path.realpath(source)
    if source==source_root or os.path.commonpath([source_root,source])!=source_root or not os.path.isdir(source):raise ValueError('Source outside template root')
    user=policy['users'][game]
    port=payload.get('port')
    if not isinstance(port,int) or not 25000<=port<=25999:raise ValueError('Port must be between 25000 and 25999')
    if not isinstance(user,str) or not re.fullmatch(r'[a-z_][a-z0-9_-]*',user):raise ValueError('Invalid user')
    account=pwd.getpwnam(user)
    if account.pw_uid==0 or account.pw_gid==0:raise ValueError('Non-root game user and group required')
    target=target_root+'/'+folder
    if os.path.lexists(target):raise ValueError('Destination already exists; never overwritten')
    return dict(payload,source=source,target=target,user=user,uid=account.pw_uid,gid=account.pw_gid)

def isolated_user(data):
    name='gd_'+data['game'][:12]+'_'+hashlib.sha256((data['unit']+'\0'+data['target']).encode()).hexdigest()[:12]
    try:account=pwd.getpwnam(name)
    except KeyError:
        subprocess.run(['/usr/sbin/useradd','--system','--gid',str(data['gid']),'--no-create-home',
            '--home-dir',data['target'],'--shell','/usr/sbin/nologin',name],check=True,capture_output=True,timeout=8)
        account=pwd.getpwnam(name)
    if account.pw_uid==0 or account.pw_gid!=data['gid'] or account.pw_dir!=data['target']:raise ValueError('Instance account does not match its protected policy')
    return dict(data,user=name,uid=account.pw_uid)

def prepare():
    os.makedirs(JOBS,mode=0o700,exist_ok=True)
    for path in ('/var/lib/gamedock','/var/lib/gamedock/provision',JOBS):secure(path,True)

def create(payload):
    prepare();lock=locked()
    try:
        path=job_path(payload['job'])
        if os.path.exists(path):
            old=read_job(payload['job'])
            if any(old['request'].get(k,0 if k=='disk_limit_mb' else None)!=payload.get(k,0 if k=='disk_limit_mb' else None) for k in ('job','unit','game','source','folder','port','minecraft_type','disk_limit_mb')):raise ValueError('Job request mismatch')
            return public(old)
        cfg=config()
        game=payload.get('game','')
        if re.fullmatch(r'[a-z][a-z0-9_-]{0,31}',game) and game not in cfg['_provision']['users']:
            if not cfg['_provision'].get('allow_custom_games'):raise ValueError('Custom game types are not enabled')
            name='gdt_'+hashlib.sha256(game.encode()).hexdigest()[:16]
            try:pwd.getpwnam(name)
            except KeyError:subprocess.run(['/usr/sbin/useradd','--system','--no-create-home','--shell','/usr/sbin/nologin',name],check=True,capture_output=True)
            cfg['_provision']['users'][game]=name;atomic(CONFIG,cfg)
        validated=validate(payload,cfg);unit=validated['unit'];target=validated['target']
        if unit in cfg:raise ValueError('Unit already registered')
        for existing in cfg.get('_copy_jobs',{}).values():
            try:previous=read_job(existing)
            except FileNotFoundError:continue
            if previous['state'] in ('queued','running') and (previous['data']['target']==target or previous['data']['unit']==unit):raise ValueError('Copy already reserved')
        validated=isolated_user(validated)
        job={'request':payload,'data':validated,'state':'queued','message':'A fájlmásolás indításra vár.'}
        atomic(path,job)
        cfg.setdefault('_copy_jobs',{})[unit]=payload['job'];atomic(CONFIG,cfg)
        try:
            with open(JOBS+'/'+payload['job']+'.log','ab') as output:
                child=subprocess.Popen(['/usr/bin/python3','-I',SELF,'worker',payload['job']],stdin=subprocess.DEVNULL,
                    stdout=output,stderr=subprocess.STDOUT,start_new_session=True,env=runtime.environment())
            job['worker']=runtime.identity(child.pid);atomic(path,job)
        except (OSError,subprocess.SubprocessError):
            job['state']='failed';job['message']='A Linux másolási munkafolyamata nem indítható.';atomic(path,job)
        return public(job)
    finally:fcntl.flock(lock,fcntl.LOCK_UN);lock.close()

def copy_files(source,target):
    if os.geteuid()==0:raise ValueError('Copy must run without root privileges')
    count=0
    for directory,dirs,files in os.walk(source,followlinks=False):
        for name in dirs+files:
            mode=os.lstat(os.path.join(directory,name)).st_mode
            if not(stat.S_ISDIR(mode) or stat.S_ISREG(mode)):raise ValueError('Only ordinary files and directories are permitted')
            if stat.S_ISREG(mode):count+=1
    if count==0:raise ValueError('Template is empty')
    shutil.copytree(source,target,dirs_exist_ok=True,symlinks=False)

def configure(folder,settings):
    if os.geteuid()==0:raise ValueError('Configuration writes must run as game user')
    port=settings['port']
    if not isinstance(port,int) or not 25000<=port<=25999:raise ValueError('Invalid port')
    root=Path(folder)
    # Remember only files which originally contained a port placeholder.
    # Reconfigure as the instance user, preserving every other edited setting.
    manifest=root/'.gamedock-ports.json'
    previous={}
    if manifest.exists():
        previous=json.loads(manifest.read_text())
        if not isinstance(previous,dict) or not isinstance(previous.get('files',[]),list):raise ValueError('Invalid port manifest')
    old=previous.get('port',settings.get('previous_port'))
    tracked=set()
    for relative in previous.get('files',[]):
        if not isinstance(relative,str):raise ValueError('Invalid config path')
        target=root/relative
        if not target.resolve().is_relative_to(root.resolve()):raise ValueError('Config path escapes game directory')
        if target.is_file() and target.stat().st_size<1024*1024:
            text=target.read_text()
            if type(old) is int and 25000<=old<=25999:text=re.sub(r'(?<![0-9])'+str(old)+r'(?![0-9])',str(port),text)
            target.write_text(text);tracked.add(relative)
    if settings.get('minecraft'):
        if not settings.get('eula'):raise ValueError('Minecraft EULA acceptance required')
        props=root/'server.properties';lines=props.read_text().splitlines() if props.exists() else []
        lines=[line for line in lines if not line.startswith(('server-port=','query.port='))]
        props.write_text('\n'.join(lines+['server-port='+str(port),'query.port='+str(port)])+'\n')
        (root/'eula.txt').write_text('eula=true\n')
    if settings['game']=='fivem':
        file=root/'server.cfg';lines=file.read_text().splitlines() if file.exists() else []
        lines=[line for line in lines if not line.lstrip().startswith(('endpoint_add_tcp','endpoint_add_udp'))]
        file.write_text('\n'.join(lines+['endpoint_add_tcp "0.0.0.0:'+str(port)+'"','endpoint_add_udp "0.0.0.0:'+str(port)+'"'])+'\n')
    for file in ([] if settings.get('reconfigure') else root.rglob('*')):
        if file.is_file() and file.suffix.lower() in ('.cfg','.properties','.json','.yml','.yaml','.txt') and file.stat().st_size<1024*1024:
            try:content=file.read_text()
            except UnicodeError:continue
            if '{{PORT}}' in content:
                file.write_text(content.replace('{{PORT}}',str(port)));tracked.add(str(file.relative_to(root)))
    manifest.write_text(json.dumps({'port':port,'files':sorted(tracked)}))

def worker(job_id):
    with locked() as initial_lock:
        job=read_job(job_id)
    path=job_path(job_id)
    if job['state']!='queued':return
    try:
        data=isolated_user(validate(job['request'],config()))
        if data!=job['data']:raise ValueError('Provision policy changed')
        job['state']='running';job['message']='A szerverfájlok másolása folyamatban van.';atomic(path,job)
        stage=os.path.dirname(data['target'])+'/.gamedock-copy-'+job_id
        os.mkdir(stage,0o700);os.chown(stage,data['uid'],data['gid'])
        if data.get('disk_limit_mb',0):storage_module().attach(data['unit'],stage,data['disk_limit_mb'])
        # No shell and no root copy: template symlinks cannot expose root-only files.
        subprocess.run(['/usr/bin/python3','-I',SELF,'copy',data['source'],stage,base64.b64encode(json.dumps({'game':data['game'],'port':data['port'],'minecraft':bool(data.get('minecraft_type')),'eula':bool(data.get('eula_accepted'))}).encode()).decode()],check=True,timeout=3600,capture_output=True,start_new_session=True,preexec_fn=runtime.drop(pwd.getpwnam(data['user'])),env=runtime.environment(pwd.getpwnam(data['user'])))
        lock=locked()
        try:
            cfg=config()
            if data['unit'] in cfg or os.path.lexists(data['target']):raise ValueError('Destination/unit occupied')
            if cfg.get('_copy_jobs',{}).get(data['unit'])!=job_id:raise ValueError('Reservation changed')
            os.chmod(stage,0o700)
            os.rename(stage,data['target'])
            cfg[data['unit']]={'launch':True,'user':data['user'],'directory':data['target'],'provision_job':job_id,'port':data['port'],'game':data['game'],'disk_limit_mb':data.get('disk_limit_mb',0),'minecraft_type':data.get('minecraft_type'),'template_key':data.get('template_key'),'template_version':data.get('template_version')}
            cfg['_copy_jobs'].pop(data['unit'],None);atomic(CONFIG,cfg)
            job['state']='ready';job['message']='A fájlmásolás kész. A szerver indítható.';atomic(path,job)
        finally:fcntl.flock(lock,fcntl.LOCK_UN);lock.close()
    except (ValueError,KeyError,OSError,subprocess.SubprocessError) as error:
        print('Copy failed: '+type(error).__name__+': '+str(error),file=sys.stderr)
        job['state']='failed';job['message']='A másolás nem sikerült. Ellenőrizd, hogy a sablon nem üres, olvasható, van szabad hely, és helyes a Linux engedélylistája. Meglévő célmappát nem írunk felül.';atomic(path,job)

if __name__=='__main__':
    try:
        action=sys.argv[1]
        if action=='copy' and len(sys.argv) in (4,5):
            copy_files(sys.argv[2],sys.argv[3])
            if len(sys.argv)==5:configure(sys.argv[3],json.loads(base64.b64decode(sys.argv[4],validate=True)))
        elif action=='reconfigure' and len(sys.argv)==4:
            configure(sys.argv[2],json.loads(base64.b64decode(sys.argv[3],validate=True)))
        elif os.geteuid()!=0:raise ValueError('Root helper required')
        elif action=='worker' and len(sys.argv)==3:worker(sys.argv[2])
        elif action=='status' and len(sys.argv)==3:
            prepare();print(json.dumps(public(read_job(sys.argv[2])),ensure_ascii=False))
        elif action=='create' and len(sys.argv)==3 and len(sys.argv[2])<=8192:
            payload=json.loads(base64.b64decode(sys.argv[2],validate=True).decode('utf-8'))
            print(json.dumps(create(payload),ensure_ascii=False))
        else:raise ValueError('Invalid operation')
    except (ValueError,KeyError,IndexError,OSError,subprocess.SubprocessError):
        print('Provisioning failed: check root policy, template path, unit and destination',file=sys.stderr);sys.exit(1)
