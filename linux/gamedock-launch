#!/usr/bin/python3
"""Run the admin command directly as the pinned game user. No service manager."""
import importlib.machinery
import contextlib
import base64
import fcntl
import importlib.util
import json
import os
from pathlib import Path
import pwd
import re
import select
import signal
import socket
import stat
import subprocess
import sys
import time

library=Path(__file__).resolve().parent/'gamedock_runtime.py'
if not library.is_file():library=Path('/usr/local/libexec/gamedock_runtime.py')
spec=importlib.util.spec_from_file_location('gamedock_runtime',library);runtime=importlib.util.module_from_spec(spec);spec.loader.exec_module(runtime)
CONFIG='/etc/gamedock/servers.json'
CONTROL='/run/gamedock-control'
RUNTIME='/run/gamedock'
LOGS='/var/log/gamedock'
RUNNER='/usr/local/libexec/gamedock-runner'

def secure_directory(path,mode):
    os.makedirs(path,mode=mode,exist_ok=True)
    info=os.lstat(path)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid!=0 or info.st_mode & 0o022:raise ValueError('Unsafe root directory')
    os.chmod(path,mode)

def decode(value,limit):
    if len(value)>8192:raise ValueError('Payload too large')
    result=base64.b64decode(value,validate=True).decode('utf-8')
    if not result.strip() or len(result.encode())>limit or any(ord(c)<32 or ord(c)==127 for c in result):raise ValueError('Invalid command')
    return result

def metadata(name):
    try:
        with open(CONTROL+'/'+name+'.json') as stream:return json.load(stream)
    except FileNotFoundError:return {}

def active(data,account):
    return runtime.alive(data.get('runner'),account.pw_uid) or runtime.alive(data.get('game'),account.pw_uid) or bool(runtime.group_records(data['_name'],account.pw_uid) if data.get('_name') else [])

def descendants(data,account):
    parents={value['pid'] for key,value in data.items() if key in ('runner','game') and runtime.alive(value,account.pw_uid)}
    found={}
    for _ in range(8):
        for entry in os.scandir('/proc'):
            if not entry.name.isdigit():continue
            record=runtime.identity(int(entry.name))
            if not record or record['uid']!=account.pw_uid:continue
            try:
                with open(entry.path+'/stat') as stream:parent=int(stream.read().rsplit(') ',1)[1].split()[1])
            except (OSError,ValueError,IndexError):continue
            if int(entry.name) in parents or parent in parents:parents.add(int(entry.name));found[int(entry.name)]=record
    return list(found.values())

def stop(data,account):
    targets=descendants(data,account)
    # Include detached descendants still contained by the server cgroup.
    targets+=runtime.group_records(data.get('_name',''),account.pw_uid) if data.get('_name') else []
    runtime.send(data.get('runner'),account.pw_uid,signal.SIGTERM)
    # A dead runner may leave its directly tracked game alive.
    runtime.send(data.get('game'),account.pw_uid,signal.SIGTERM)
    deadline=time.monotonic()+32
    while any(runtime.alive(record,account.pw_uid) for record in targets) and time.monotonic()<deadline:time.sleep(.1)
    for record in targets:runtime.send(record,account.pw_uid,signal.SIGKILL)
    if data.get('_name'):runtime.kill_group(data['_name'])
    deadline=time.monotonic()+2
    while active(data,account) and time.monotonic()<deadline:time.sleep(.05)
    if active(data,account):raise ValueError('Could not stop the game')

def start(name,account,directory,payload,limits=None,server=None):
    group=runtime.prepare_cgroup(name,limits or {})
    if limits and limits.get('port'):
        settings={'game':server.get('game',''),'minecraft':bool(server.get('minecraft_type')),'eula':bool(server.get('minecraft_type')),'port':limits['port'],'previous_port':server.get('port'),'reconfigure':True}
        subprocess.run(['/usr/bin/python3','-I','/usr/local/sbin/gamedock-provision','reconfigure',directory,base64.b64encode(json.dumps(settings).encode()).decode()],
            check=True,timeout=20,capture_output=True,preexec_fn=runtime.drop(account),env=runtime.environment(account),cwd=directory)
    secure_directory(RUNTIME,0o711);secure_directory(LOGS,0o700)
    folder=RUNTIME+'/'+name
    if os.path.islink(folder):raise ValueError('Unsafe runtime symlink')
    os.makedirs(folder,mode=0o700,exist_ok=True);os.chown(folder,account.pw_uid,account.pw_gid);os.chmod(folder,0o700)
    console=folder+'/console.sock'
    if os.path.lexists(console):os.unlink(console)
    readfd,writefd=os.pipe();log=open(LOGS+'/'+name+'.log','a+b')
    process=None
    try:
        process=subprocess.Popen(['/usr/bin/python3','-I',RUNNER,'--socket',console,'--command',payload,'--ready-fd',str(writefd)],
            cwd=directory,stdin=subprocess.DEVNULL,stdout=log,stderr=subprocess.STDOUT,start_new_session=True,
            pass_fds=(writefd,),preexec_fn=runtime.drop_in_cgroup(account,group),env=runtime.environment(account))
        os.close(writefd);writefd=None
        if not select.select([readfd],[],[],5)[0]:raise ValueError('Runner did not acknowledge startup')
        response=json.loads(os.read(readfd,4096))
        data={'runner':runtime.identity(process.pid),'game':runtime.identity(response['game_pid']),'cgroup':bool(group)}
        if not runtime.alive(data['runner'],account.pw_uid):raise ValueError('Runner exited during startup')
        path=CONTROL+'/'+name+'.json';temporary=path+'.tmp'
        with open(temporary,'w') as stream:json.dump(data,stream)
        os.chmod(temporary,0o600);os.replace(temporary,path)
    except (ValueError,OSError,KeyError):
        if process:
            record=runtime.identity(process.pid)
            runtime.send(record,account.pw_uid,signal.SIGTERM)
        raise
    finally:
        os.close(readfd)
        if writefd is not None:os.close(writefd)
        log.close()

def execute(argv,lock_held=False):
    if os.geteuid()!=0:raise ValueError('Root helper required')
    if len(argv) not in (3,4,5):raise ValueError('Invalid arguments')
    name,action=argv[1:3]
    if not re.fullmatch(r'[A-Za-z0-9_][A-Za-z0-9_-]*(?:\.service)?',name):raise ValueError('Invalid server identifier')
    info=os.lstat(CONFIG)
    if not stat.S_ISREG(info.st_mode) or info.st_uid!=0 or info.st_mode & 0o022:raise ValueError('Unsafe configuration')
    with open(CONFIG) as stream:configuration=json.load(stream);server=configuration[name]
    if server.get('launch') is not True:raise ValueError('Direct launch is not configured')
    account=pwd.getpwnam(server['user']);directory=server['directory']
    if account.pw_uid==0 or account.pw_gid==0 or not os.path.isabs(directory) or not os.path.isdir(directory):raise ValueError('Non-root user and game folder required')
    if action not in ('start','restart','stop','status','metrics','logs','command'):raise ValueError('Invalid action')
    if action in ('start','restart'):
        if len(argv) not in (4,5):raise ValueError('Invalid argument count')
    elif len(argv)!=(4 if action=='command' else 3):raise ValueError('Invalid argument count')
    limits=runtime.limits_payload(argv[4]) if len(argv)==5 else {}
    payload=decode(argv[3],500 if action=='command' else 4096) if len(argv)>=4 else None
    secure_directory(CONTROL,0o700)
    with (contextlib.nullcontext(None) if lock_held else open(CONTROL+'/'+name+'.lock','a')) as lock:
        if lock is not None:fcntl.flock(lock,fcntl.LOCK_EX)
        data=metadata(name);data['_name']=name
        maintenance=Path('/var/lib/gamedock/automation/units')/name/'job.json'
        if not lock_held and action in ('start','restart') and maintenance.exists():
            job=json.loads(maintenance.read_text())
            if job.get('state') in ('queued','running') or (job.get('operation')=='restore' and job.get('state')=='ready' and not job.get('reconciled')):raise ValueError('Backup or restore is running; refresh backup status before starting')
        if action in ('start','restart'):
            # Re-read after taking the same per-instance lock as version creation.
            with open(CONFIG) as stream:latest=json.load(stream)
            job=latest.get('_version_jobs',{}).get(name)
            if job:
                with open('/var/lib/gamedock/provision/jobs/'+job+'.json') as stream:version=json.load(stream)
                if version['state'] in ('queued','running'):raise ValueError('Version change is running; startup is locked')
        if action=='status':print('active' if active(data,account) else 'inactive');return
        if action=='metrics':
            storage_path=Path(__file__).resolve().parent/'gamedock-storage'
            if not storage_path.is_file():storage_path=Path('/usr/local/sbin/gamedock-storage')
            storage_loader=importlib.machinery.SourceFileLoader('launch_storage',str(storage_path));storage_spec=importlib.util.spec_from_loader(storage_loader.name,storage_loader);storage=importlib.util.module_from_spec(storage_spec);storage_loader.exec_module(storage)
            disk=storage.metrics(name)
            running=active(data,account)
            if not running:print(json.dumps(dict(disk,state='inactive',cpu_percent=0,memory_bytes=0,limits_enforced=False)));return
            records=descendants(data,account);before=runtime.usage_snapshot(name,records,data.get('cgroup',False));stamp=time.monotonic();time.sleep(.2)
            after=runtime.usage_snapshot(name,descendants(data,account),data.get('cgroup',False));elapsed=time.monotonic()-stamp
            print(json.dumps(dict(disk,state='active',cpu_percent=round(max(0,after[0]-before[0])/elapsed*100,1),memory_bytes=after[1],limits_enforced=after[2])));return
        if action=='logs':
            secure_directory(LOGS,0o700)
            try:
                with open(LOGS+'/'+name+'.log','rb') as stream:stream.seek(max(0,os.fstat(stream.fileno()).st_size-131072));output=stream.read()
            except FileNotFoundError:output=b''
            sys.stdout.write(b'\n'.join(output.splitlines()[-150:]).decode('utf-8',errors='replace'));return
        if action=='command':
            if not active(data,account):raise ValueError('Game is not running')
            with socket.socket(socket.AF_UNIX,socket.SOCK_STREAM) as client:
                client.settimeout(3);client.connect(RUNTIME+'/'+name+'/console.sock');client.sendall(payload.encode()+b'\n');client.shutdown(socket.SHUT_WR)
                if client.recv(16)!=b'OK':raise ValueError('Console input not acknowledged')
            print('Console input delivered');return
        if action=='start' and active(data,account):print('Already running');return
        if action in ('restart','stop'):stop(data,account)
        if action=='stop':print('Stopped');return
        start(name,account,directory,argv[3],limits,server);print('Game command started')

if __name__=='__main__':
    os.umask(0o077)
    try:execute(sys.argv)
    except (ValueError,KeyError,OSError,subprocess.SubprocessError) as error:
        print('Game operation failed: '+str(error),file=sys.stderr);sys.exit(1)
