#!/usr/bin/python3
"""Unprivileged game PTY and console socket; systemd owns the entire process cgroup."""
import argparse
import base64
import errno
import os
import pty
import selectors
import select
import time
import socket
import subprocess
import sys

def serve(path, command):
    if os.geteuid()==0: raise ValueError('Runner must never run as root')
    if not command.strip() or len(command.encode())>4096 or any(ord(c)<32 or ord(c)==127 for c in command): raise ValueError('Invalid startup command')
    os.umask(0o077)
    listener=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM)
    selector=selectors.DefaultSelector()
    process=None; master=None
    try:
        listener.bind(path); listener.listen(4); listener.setblocking(False)
        master,slave=pty.openpty()
        try:
            # Only this game user's shell interprets the admin-authored command.
            process=subprocess.Popen(['/bin/bash','-c',command],stdin=slave,stdout=slave,stderr=slave,start_new_session=True)
        finally: os.close(slave)
        os.set_blocking(master,False)
        selector.register(master,selectors.EVENT_READ,'output')
        selector.register(listener,selectors.EVENT_READ,'console')
        while process.poll() is None:
            for key,_ in selector.select(timeout=.2):
                if key.data=='output':
                    try: data=os.read(master,65536)
                    except OSError as exc:
                        if exc.errno==errno.EIO: return process.wait()
                        raise
                    if data: sys.stdout.buffer.write(data);sys.stdout.buffer.flush()
                else:
                    connection,_=listener.accept()
                    with connection:
                        connection.settimeout(2); data=b''
                        while len(data)<=501:
                            chunk=connection.recv(502-len(data))
                            if not chunk: break
                            data+=chunk
                        if len(data)<2 or len(data)>501 or not data.endswith(b'\n'): continue
                        content=data[:-1]
                        if any(c<32 or c==127 for c in content): continue
                        # Writes literal terminal input, never another Linux shell command.
                        pending=memoryview(data); deadline=time.monotonic()+2
                        while pending:
                            if time.monotonic()>deadline: raise OSError('Console write timed out')
                            try: written=os.write(master,pending)
                            except BlockingIOError:
                                select.select([], [master], [], .1); continue
                            pending=pending[written:]
                        connection.sendall(b'OK')
        # Drain trailing output on normal exit.
        while True:
            try: data=os.read(master,65536)
            except (BlockingIOError,OSError): break
            if not data: break
            sys.stdout.buffer.write(data);sys.stdout.buffer.flush()
        return process.returncode
    finally:
        selector.close();listener.close()
        if master is not None: os.close(master)
        if process is not None and process.poll() is None:
            process.terminate()
            try: process.wait(timeout=2)
            except subprocess.TimeoutExpired: process.kill();process.wait()
        try: os.unlink(path)
        except FileNotFoundError: pass

if __name__=='__main__':
    parser=argparse.ArgumentParser();parser.add_argument('--socket',required=True);parser.add_argument('--command',required=True)
    args=parser.parse_args()
    try:
        command=base64.b64decode(args.command,validate=True).decode('utf-8')
        sys.exit(serve(args.socket,command))
    except (ValueError,OSError,subprocess.SubprocessError):
        print('Game runner failed; check permissions and game command',file=sys.stderr);sys.exit(1)
