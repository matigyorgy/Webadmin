#!/usr/bin/python3
"""Offline Minecraft version replacement with a complete instance backup."""
import base64,fcntl,importlib.machinery,importlib.util,json,os,pwd,re,shutil,subprocess,sys
from pathlib import Path
path=Path(__file__).resolve().parent/'gamedock-provision'
if not path.exists():path=Path('/usr/local/sbin/gamedock-provision')
loader=importlib.machinery.SourceFileLoader('provision',str(path));spec=importlib.util.spec_from_loader(loader.name,loader);p=importlib.util.module_from_spec(spec);loader.exec_module(p)
SELF='/usr/local/sbin/gamedock-versions';CONTROL='/run/gamedock-control';CATALOG='/var/lib/gamedock/minecraft/catalog.json'

def unit_lock(unit,wait=True):
    os.makedirs(CONTROL,mode=0o700,exist_ok=True);p.secure(CONTROL,True)
    handle=open(CONTROL+'/'+unit+'.lock','a');fcntl.flock(handle,fcntl.LOCK_EX|(0 if wait else fcntl.LOCK_NB));return handle

def status(job_id):
    try:
        with open(p.job_path(job_id)) as stream:job=json.load(stream)
    except FileNotFoundError:return {'state':'missing','message':'A verzióváltási feladat nem található.'}
    if job.get('operation')!='version':raise ValueError('Wrong job kind')
    if job['state'] in ('queued','running') and job.get('worker') and not p.runtime.alive(job['worker'],0):
        with unit_lock(job['unit']),p.locked():
            target=Path(job['target']);backup=Path(job['backup']);stage=Path(job['stage'])
            if job.get('phase')=='switching' and backup.exists() and target.exists() and not stage.exists():
                cfg=p.config();cfg[job['unit']].update(minecraft_type=None if job['template'].get('provider')=='folder' else job['template']['type'],template_key=job['template']['key'],template_version=job['template']['version']);p.atomic(p.CONFIG,cfg)
                job.update(state='ready',message='A verzióváltás elkészült; az előző példány mentése: '+str(backup))
            else:
                if not target.exists() and backup.exists():os.rename(backup,target)
                job.update(state='failed',message='A verzióváltás megszakadt. Az eredeti szerverfájlok megmaradtak.')
            p.atomic(p.job_path(job_id),job)
    return p.public(job)

def create_lock():
    handle=open(p.CONFIG+'.lock','a');fcntl.flock(handle,fcntl.LOCK_EX|fcntl.LOCK_NB);return handle

def create(payload):
    job_id=payload['job'];p.job_path(job_id);unit=payload['unit'];key=payload['template_key']
    reinstall=payload.get('reinstall',False)
    if type(reinstall) is not bool or (reinstall and payload.get('confirmed') is not True):raise ValueError('Reinstallation requires explicit confirmation')
    if not isinstance(unit,str) or not re.fullmatch(r'[A-Za-z0-9_][A-Za-z0-9_-]*(?:\.service)?',unit):raise ValueError('Invalid unit')
    p.prepare()
    with unit_lock(unit,False),create_lock():
        cfg=p.config();server=cfg[unit];account=pwd.getpwnam(server['user'])
        maintenance=Path('/var/lib/gamedock/automation/units')/unit/'job.json'
        if maintenance.exists():
            maintenance_job=json.loads(maintenance.read_text())
            if maintenance_job.get('state') in ('queued','running') or (maintenance_job.get('operation')=='restore' and maintenance_job.get('state')=='ready' and not maintenance_job.get('reconciled')):raise ValueError('Backup or restore is running')
        if Path(p.job_path(job_id)).exists():
            with open(p.job_path(job_id)) as stream:existing=json.load(stream)
            if existing.get('operation')!='version' or existing.get('unit')!=unit or existing.get('template',{}).get('key')!=key or existing.get('reinstall',False)!=reinstall:raise ValueError('Job token mismatch')
            return p.public(existing)
        if account.pw_uid==0:raise ValueError('Non-root instance required')
        previous=cfg.get('_version_jobs',{}).get(unit)
        if previous:
            with open(p.job_path(previous)) as stream:old=json.load(stream)
            if old['state'] in ('queued','running'):raise ValueError('Version change is already active')
        control=Path(CONTROL)/(unit+'.json');data=json.loads(control.read_text()) if control.exists() else {}
        if any(p.runtime.alive(data.get(k),account.pw_uid) for k in ('runner','game')) or p.runtime.group_records(unit,account.pw_uid):raise ValueError('Stop the server before changing version')
        try:
            with open(CATALOG) as stream:catalog=json.load(stream)
        except FileNotFoundError:catalog={'templates':[]}
        custom=Path(CATALOG).with_name('custom.json')
        if custom.exists():catalog['templates']+=json.loads(custom.read_text())
        row=next((r for r in catalog['templates'] if r['key']==key and r['state']=='ready'),None)
        if not row:raise ValueError('Ready template required')
        minecraft=bool(server.get('minecraft_type'))
        if minecraft and (row.get('provider')=='folder' or row['type'] not in ('vanilla','paper','forge','bukkit','spigot','purpur','fabric')):raise ValueError('Minecraft template required')
        if not minecraft and (row.get('provider')!='folder' or row.get('game')!=server['game']):raise ValueError('Template game mismatch')
        parts=[row['type'],row['version'],row['build']]
        if row.get('provider')!='folder' and any(not re.fullmatch(r'[A-Za-z0-9._-]{1,100}',v) or v in ('.','..') for v in parts):raise ValueError('Invalid template path')
        root=Path(cfg['_provision']['source_root']);source=Path(row['path']) if row.get('provider')=='folder' else root.joinpath('minecraft',*parts)
        if source.is_symlink() or not source.is_dir() or source.resolve()!=source or not source.resolve().is_relative_to(root.resolve()) or str(source)!=row['path']:raise ValueError('Unsafe template path')
        target=Path(server['directory']);base=Path(cfg['_provision']['target_root'])
        if target.parent!=base or target.is_symlink() or not target.is_dir():raise ValueError('Unsafe instance path')
        backup_base=base/'.gamedock-backups';backup_base.mkdir(mode=0o711,exist_ok=True);p.secure(backup_base,True)
        owner_backup=backup_base/unit;owner_backup.mkdir(mode=0o711,exist_ok=True);p.secure(owner_backup,True)
        stage=base/('.gamedock-version-'+job_id);stage.mkdir(mode=0o700);os.chown(stage,account.pw_uid,account.pw_gid)
        job={'reinstall':reinstall,'settings':{'game':server['game'],'port':server['port'],'minecraft':minecraft,'eula':minecraft},'operation':'version','unit':unit,'source':str(source),'target':str(target),'backup':str(owner_backup/job_id),'stage':str(stage),'user':server['user'],'template':row,'state':'queued','message':'A verzióváltás előkészítése elindult.'}
        ftp_path=Path(__file__).resolve().parent/'gamedock-ftp'
        if not ftp_path.exists():ftp_path=Path('/usr/local/sbin/gamedock-ftp')
        ftp_loader=importlib.machinery.SourceFileLoader('version_ftp',str(ftp_path));ftp_spec=importlib.util.spec_from_loader(ftp_loader.name,ftp_loader);ftp=importlib.util.module_from_spec(ftp_spec);ftp_loader.exec_module(ftp);ftp.disconnect_unit(unit)
        p.atomic(p.job_path(job_id),job);cfg.setdefault('_version_jobs',{})[unit]=job_id;p.atomic(p.CONFIG,cfg)
        try:
            with open(p.JOBS+'/'+job_id+'.log','ab') as output:child=subprocess.Popen(['/usr/bin/python3','-I',SELF,'worker',job_id],stdin=subprocess.DEVNULL,stdout=output,stderr=subprocess.STDOUT,start_new_session=True,env=p.runtime.environment())
            job['worker']=p.runtime.identity(child.pid);p.atomic(p.job_path(job_id),job)
        except OSError:
            job.update(state='failed',message='A verzióváltási folyamat nem indítható.');p.atomic(p.job_path(job_id),job)
        return p.public(job)

def copy(source,current,stage,reinstall=False,settings=None):
    if os.geteuid()==0:raise ValueError('Version copy must not run as root')
    if reinstall:
        p.copy_files(source,stage)
        if settings:p.configure(stage,settings)
        return
    p.copy_files(current,stage)
    preserved={'server.properties','eula.txt','server.cfg','ops.json','whitelist.json','banned-players.json','banned-ips.json','.gamedock-ports.json'}
    for directory,dirs,files in os.walk(source,followlinks=False):
        for name in dirs+files:
            entry=Path(directory)/name
            if entry.is_symlink() or not (entry.is_file() or entry.is_dir()):raise ValueError('Unsafe template file')
        for name in files:
            origin=Path(directory)/name;relative=origin.relative_to(source)
            if relative.parts[0] in ('world','world_nether','world_the_end','plugins','mods','config') or str(relative) in preserved:continue
            destination=Path(stage)/relative;destination.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(origin,destination)
    if settings:p.configure(stage,settings)

def worker(job_id):
    with p.locked():
        with open(p.job_path(job_id)) as stream:job=json.load(stream)
        job.update(state='running',message='Szerveradatok másolása és az új verzió előkészítése.');p.atomic(p.job_path(job_id),job)
    try:
        account=pwd.getpwnam(job['user']);limit=p.config()[job['unit']].get('disk_limit_mb',0)
        if limit:p.storage_module().attach(job['unit'],job['stage'],limit)
        subprocess.run(['/usr/bin/python3','-I',SELF,'copy',job['source'],job['target'],job['stage'],base64.b64encode(json.dumps({'reinstall':job.get('reinstall',False),'settings':job.get('settings')}).encode()).decode()],check=True,timeout=7200,capture_output=True,preexec_fn=p.runtime.drop(account),env=p.runtime.environment(account))
        with unit_lock(job['unit']),p.locked():
            cfg=p.config()
            if cfg.get('_version_jobs',{}).get(job['unit'])!=job_id:raise ValueError('Version reservation changed')
            job['phase']='switching';p.atomic(p.job_path(job_id),job)
            os.rename(job['target'],job['backup'])
            try:os.rename(job['stage'],job['target'])
            except OSError:os.rename(job['backup'],job['target']);raise
            cfg[job['unit']].update(minecraft_type=None if job['template'].get('provider')=='folder' else job['template']['type'],template_key=job['template']['key'],template_version=job['template']['version']);p.atomic(p.CONFIG,cfg)
            job.update(state='ready',message='A verzióváltás elkészült; az előző példány mentése: '+job['backup']);p.atomic(p.job_path(job_id),job)
    except (ValueError,OSError,subprocess.SubprocessError) as error:
        print(type(error).__name__+': '+str(error),file=sys.stderr)
        job.update(state='failed',message='A verzióváltás nem sikerült. Az eredeti szerverfájlok megmaradtak; ellenőrizd a szabad helyet és a sablont.');p.atomic(p.job_path(job_id),job)

if __name__=='__main__':
    os.umask(0o077)
    try:
        action=sys.argv[1]
        if action=='copy' and len(sys.argv) in (5,6):
            options=json.loads(base64.b64decode(sys.argv[5],validate=True)) if len(sys.argv)==6 else {}
            copy(*sys.argv[2:5],**options)
        elif os.geteuid()!=0:raise ValueError('Root helper required')
        elif action=='create' and len(sys.argv)==3 and len(sys.argv[2])<2048:print(json.dumps(create(json.loads(base64.b64decode(sys.argv[2],validate=True))),ensure_ascii=False))
        elif action=='status' and len(sys.argv)==3:print(json.dumps(status(sys.argv[2]),ensure_ascii=False))
        elif action=='worker' and len(sys.argv)==3:worker(sys.argv[2])
        else:raise ValueError('Invalid version operation')
    except (ValueError,KeyError,IndexError,OSError,subprocess.SubprocessError) as error:
        print(type(error).__name__+': '+str(error),file=sys.stderr);sys.exit(1)
