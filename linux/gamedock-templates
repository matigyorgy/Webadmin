        for member in source:
            normal=posixpath.normpath(member.name)
            if member.name.startswith('/') or normal=='..' or normal.startswith('../') or not(member.isfile() or member.isdir() or member.issym() or member.islnk()):raise ValueError('Unsafe JDK archive')
