def install_jdk(required,settings):
    if not 8<=required<=99:raise ValueError('Invalid Java requirement')
    root=Path(settings['_provision']['source_root']);destination=root/'.java'/str(required)
    if (destination/'bin/java').is_file():return str(destination/'bin/java')
    arch={'x86_64':'x64','aarch64':'aarch64'}.get(platform.machine())
    if not arch:raise ValueError('Unsupported Java architecture')
    assets=metadata('https://api.adoptium.net/v3/assets/latest/'+str(required)+'/hotspot?architecture='+arch+'&image_type=jdk&os=linux')
    package=assets[0]['binary']['package'];digest=package['checksum']
    if not re.fullmatch(r'[a-fA-F0-9]{64}',digest):raise ValueError('JDK checksum missing')
    account=pwd.getpwnam(settings['_provision']['users']['minecraft']);stage=Path(tempfile.mkdtemp(prefix='.jdk-',dir=root));os.chown(stage,account.pw_uid,account.pw_gid)
    payload={'url':package['link'],'algorithm':'sha256','digest':digest}
    try:
        env=rt.environment(account);env.update({k:v for k,v in os.environ.items() if k.lower() in ('http_proxy','https_proxy','no_proxy','ssl_cert_file')})
        subprocess.run(['/usr/bin/python3','-I',SELF,'jdk',base64.b64encode(json.dumps(payload).encode()).decode(),str(stage)],preexec_fn=rt.drop(account),env=env,check=True,timeout=1200)
        folders=[p for p in stage.iterdir() if p.is_dir() and (p/'bin/java').is_file()]
        if len(folders)!=1:raise ValueError('JDK output missing')
        public_directory(destination.parent);os.rename(folders[0],destination);return str(destination/'bin/java')
    finally:
        if shutil.rmtree.avoids_symlink_attacks:shutil.rmtree(stage)

def java_for(row,settings):
    override=settings.get('_minecraft',{}).get('java')
    if override:return override
    parts=tuple(map(int,row['version'].split('.')))
    if not row.get('java') and row['version'] in RELEASES and row['version'] not in JAVA_VERSIONS:JAVA_VERSIONS[row['version']]=metadata(RELEASES[row['version']]).get('javaVersion',{}).get('majorVersion')
    required=row.get('java') or JAVA_VERSIONS.get(row['version']) or (21 if parts>=(1,20,5) else 17 if parts>=(1,18) else 16 if parts>=(1,17) else 8)
    candidates=list(Path('/usr/lib/jvm').glob('java-'+str(required)+'-*/bin/java'))
    if candidates:return str(candidates[0])
    result=subprocess.run(['/usr/bin/java','-version'],capture_output=True,text=True,timeout=10) if os.path.exists('/usr/bin/java') else None
    match=re.search(r'version "(?:1\.)?(\d+)',result.stderr if result else '')
    if not match or int(match.group(1))!=required:return install_jdk(required,settings)
    return '/usr/bin/java'

def build_command(arguments,cwd,timeout,env=None):
    if os.geteuid()==0:raise ValueError('Build command must be unprivileged')
    process=subprocess.Popen(arguments,cwd=cwd,start_new_session=True,env=env)
    try:
        code=process.wait(timeout=timeout)
        if code:raise subprocess.CalledProcessError(code,arguments)
    finally:
        try:os.killpg(process.pid,signal.SIGTERM)
        except (ProcessLookupError,PermissionError):pass
        if process.poll() is None:
            try:process.wait(timeout=3)
            except subprocess.TimeoutExpired:os.killpg(process.pid,signal.SIGKILL);process.wait()

def build(row,stage,java):
