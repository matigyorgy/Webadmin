        env=rt.environment();env.update({k:v for k,v in os.environ.items() if k.lower() in ('http_proxy','https_proxy','no_proxy','ssl_cert_file')})
        with open(CACHE+'/sync.log','ab') as log:child=subprocess.Popen(['/usr/bin/python3','-I',SELF,'worker'],stdin=subprocess.DEVNULL,stdout=log,stderr=subprocess.STDOUT,start_new_session=True,env=env)
