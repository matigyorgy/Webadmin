def metadata(url):return json.loads(text(url))
def versions(values):return sorted({v for v in values if re.fullmatch(r'\d+\.\d+(?:\.\d+)?',v)},key=lambda v:tuple(map(int,v.split('.'))),reverse=True)
def entry(kind,version,build,url,algorithm=None,digest=None):
