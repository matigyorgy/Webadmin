                target=posixpath.normpath(posixpath.join(posixpath.dirname(normal) if member.issym() else '',member.linkname))
                if member.linkname.startswith('/') or target=='..' or target.startswith('../'):raise ValueError('Unsafe JDK link')
            final=os.path.realpath(os.path.join(destination,normal))
            if os.path.commonpath([os.path.realpath(destination),final])!=os.path.realpath(destination):raise ValueError('JDK path escaped')
            member.mode &= 0o777
