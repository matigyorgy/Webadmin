            if job.get('state') in ('queued','running') and source==str(target):raise ValueError('Template is in use by an active copy job')
        if target.exists():shutil.rmtree(target)
        value['templates']=[entry for entry in value['templates'] if entry['key']!=key]
        value['message']='A kiválasztott Minecraft-template törölve. A következő szinkronizálás újra letöltheti.'
        atomic(CACHE+'/catalog.json',value);return value
def sync(selection=None):
