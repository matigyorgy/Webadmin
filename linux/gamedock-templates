def public_directory(path):
    path=Path(path)
    if not path.exists():path.mkdir(mode=0o755)
    info=path.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid!=0 or info.st_mode&0o022:raise ValueError('Unsafe template publication directory')
    os.chmod(path,0o755)

def atomic(path,data):
    descriptor,tmp=tempfile.mkstemp(dir=os.path.dirname(path))
    try:
        with os.fdopen(descriptor,'w') as stream:json.dump(data,stream,ensure_ascii=False)
        os.replace(tmp,path)
    finally:
        if os.path.exists(tmp):os.unlink(tmp)

def cfg():
    info=os.lstat(CONFIG)
    if info.st_uid!=0 or info.st_mode&0o022 or not __import__('stat').S_ISREG(info.st_mode):raise ValueError('Unsafe config')
    with open(CONFIG) as stream:return json.load(stream)

def allowed(url):
