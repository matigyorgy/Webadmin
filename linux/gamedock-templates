    for version in versions(v for group in project['versions'].values() for v in group):
        builds=metadata('https://fill.papermc.io/v3/projects/paper/versions/'+version+'/builds')
        stable=[b for b in builds if b.get('channel')=='STABLE']
        if not stable:continue
        build=max(stable,key=lambda b:int(b['id']));download=build['downloads']['server:default'];checksum=download.get('checksums',{}).get('sha256')
        if not checksum:raise ValueError('Paper SHA256 missing')
        result.append(entry('paper',version,build['id'],download['url'],'sha256',checksum))
