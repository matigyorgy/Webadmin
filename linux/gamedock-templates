    os.umask(0o022);os.chdir(stage);Path('template').mkdir();Path('work').mkdir()
    if row['type'] in ('vanilla','paper','purpur'):download(row,'template/server.jar')
    else:
        download(row,'work/installer.jar')
        if row['type']=='fabric':
            build_command([java,'-jar','../work/installer.jar','server','-mcversion',row['version'],'-loader',row['loader'],'-downloadMinecraft'],'template',3600)
            if not Path('template/fabric-server-launch.jar').is_file():raise ValueError('Fabric launcher missing')
        elif row['type']=='forge':
            build_command([java,'-jar','../work/installer.jar','--installServer'],'template',3600)
            if not Path('template/run.sh').is_file():raise ValueError('Forge runner missing')
            Path('template/user_jvm_args.txt').write_text('-Xms512M\n-Xmx2G\n')
        else:
            build_command([java,'-jar','installer.jar','--rev',row['version'],'--compile','spigot' if row['type']=='spigot' else 'craftbukkit','--output-dir','output'],'work',7200)
            jars=list(Path('work/output').glob('spigot*.jar' if row['type']=='spigot' else 'craftbukkit*.jar'))
            if len(jars)!=1:raise ValueError('CraftBukkit output missing')
            shutil.copy2(jars[0],'template/server.jar')
    Path('template/.gamedock-template.json').write_text(json.dumps({'key':row['key'],'type':row['type'],'version':row['version']}))
def catalog():
    try:
        with open(CACHE+'/catalog.json') as stream:value=json.load(stream)
        if value.get('state')=='running' and value.get('worker') and not rt.alive(value['worker'],0):value.update(state='failed',message='A katalógusfrissítés megszakadt. Újraindítható.');atomic(CACHE+'/catalog.json',value)
