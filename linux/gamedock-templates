def steam_extract(archive,destination):
    with tarfile.open(archive) as source:
        members=source.getmembers()
        if sum(max(0,m.size) for m in members)>512*1024**2:raise ValueError('SteamCMD archive too large')
        for member in members:
            normal=posixpath.normpath(member.name)
            if member.name.startswith('/') or normal=='..' or normal.startswith('../') or not(member.isfile() or member.isdir()):raise ValueError('Unsafe SteamCMD archive')
        for member in members:
            member.mode &= 0o777
            if hasattr(tarfile,'data_filter'):source.extract(member,destination,filter='data')
            else:source.extract(member,destination)

def steam_build(game,stage):
    if os.geteuid()==0:raise ValueError('SteamCMD must run as non-root')
    profile=STEAM_GAMES[game];stage=Path(stage);tools=stage/'steamcmd';tools.mkdir(mode=0o700)
    archive=stage/'steamcmd.tar.gz'
    download({'url':'https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz','algorithm':None,'digest':None},str(archive))
    steam_extract(archive,tools);archive.unlink()
    target=stage/'template';target.mkdir(mode=0o755)
    command=[str(tools/'steamcmd.sh'),'+@ShutdownOnFailedCommand','1','+@NoPromptForPassword','1','+force_install_dir',str(target),'+login','anonymous','+app_update',str(profile['app']),'validate','+quit']
    env=rt.environment();env['HOME']=str(stage);env.update({k:v for k,v in os.environ.items() if k.lower() in ('http_proxy','https_proxy','no_proxy','ssl_cert_file')})
    build_command(command,str(tools),21600,env)
    binary=target/profile['binary']
    if not binary.is_file() or binary.is_symlink() or not os.access(binary,os.X_OK):raise ValueError('Steam server executable missing')
    manifest=target/'steamapps'/('appmanifest_'+str(profile['app'])+'.acf')
    build=re.search(r'"buildid"\s+"([0-9]+)"',manifest.read_text())
    if not build:raise ValueError('Steam build ID missing')
    (stage/'result.json').write_text(json.dumps({'build':build[1]}))

def steam_worker(game,token):
    if game not in STEAM_GAMES or not re.fullmatch('[a-f0-9]{24}',token):raise ValueError('Invalid Steam job')
    # Wait until the parent has published the worker identity and released the lock.
    with open(CACHE+'/lock','a') as lock:fcntl.flock(lock,fcntl.LOCK_EX);value=catalog()
    settings=cfg();root=Path(settings['_provision']['source_root']);account=pwd.getpwnam(settings['_provision']['users'][game])
    stage=None
    try:
        if account.pw_uid==0:raise ValueError('Non-root Steam builder required')
        public_directory(root/game)
        stage=Path(tempfile.mkdtemp(prefix='.steam-build-',dir=root/game));os.chown(stage,account.pw_uid,account.pw_gid)
        env=rt.environment(account);env.update({k:v for k,v in os.environ.items() if k.lower() in ('http_proxy','https_proxy','no_proxy','ssl_cert_file')})
        subprocess.run(['/usr/bin/python3','-I',SELF,'steam-build',game,str(stage)],preexec_fn=rt.drop(account),env=env,check=True,timeout=22000)
        build=json.loads((stage/'result.json').read_text())['build']
        if not isinstance(build,str) or not re.fullmatch('[0-9]{1,30}',build):raise ValueError('Invalid Steam build ID')
        # Publish only regular files/directories; never expose a partial download.
        for directory,dirs,files in os.walk(stage/'template',followlinks=False):
            for name in dirs+files:
                mode=os.lstat(Path(directory)/name).st_mode
                if not(stat.S_ISREG(mode) or stat.S_ISDIR(mode)):raise ValueError('Unsafe Steam template file')
        final=root/game/('steam-'+build+'-'+token)
        if final.exists() or final.is_symlink():raise ValueError('Existing template not overwritten')
        os.rename(stage/'template',final);os.chmod(final,0o755)
        profile=STEAM_GAMES[game]
        save_custom({'key':'custom:'+token,'game':game,'name':profile['name'],'version':'Steam build '+build,'path':str(final),'startup':profile['startup'],'minimum_memory_mb':0})
        value.update(state='ready',message=profile['name']+' template elkészült. Steam build: '+build+'. Mappa: '+str(final))
    except Exception as error:
        print(type(error).__name__+': '+str(error),file=sys.stderr)
        value.update(state='failed',message='A Counter-Strike letöltése sikertelen. Ellenőrizd a szabad helyet, a Steam elérését és a Linux-gép /var/lib/gamedock/minecraft/steam.log naplóját. Csak a kész template használható.')
    finally:
        if stage is not None and shutil.rmtree.avoids_symlink_attacks:shutil.rmtree(stage)
        with open(CACHE+'/lock','a') as lock:fcntl.flock(lock,fcntl.LOCK_EX);atomic(CACHE+'/catalog.json',value)

