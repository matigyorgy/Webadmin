    for version in versions(mapping)[:10]:
        build=max(mapping[version],key=lambda b:tuple(map(int,b.split('.'))));artifact=version+'-'+build
        url='https://maven.minecraftforge.net/net/minecraftforge/forge/'+artifact+'/forge-'+artifact+'-installer.jar';digest=text(url+'.sha1').strip().split()[0]
        if not re.fullmatch(r'[a-fA-F0-9]{40}',digest):raise ValueError('Forge checksum missing')
        result.append(entry('forge',version,build,url,'sha1',digest))
    return result
def bukkit():
    supported=versions(re.findall(r'href="(\d+\.\d+(?:\.\d+)?)\.json"',text('https://hub.spigotmc.org/versions/')))
    build=metadata('https://hub.spigotmc.org/jenkins/job/BuildTools/lastSuccessfulBuild/api/json')['number']
    return [entry('bukkit',v,build,'https://hub.spigotmc.org/jenkins/job/BuildTools/'+str(int(build))+'/artifact/target/BuildTools.jar') for v in supported[:10]]
def spigot():
    result=bukkit()
    for row in result:row['type']='spigot';row['key']=row['key'].replace('bukkit:','spigot:',1)
    return result
def purpur():
    result=[]
