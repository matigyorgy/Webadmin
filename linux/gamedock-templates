def delete_template(key):
    if not isinstance(key,str) or len(key)>200:raise ValueError('Invalid template key')
    if key.startswith('custom:'):return delete_custom(key)
    os.makedirs(CACHE,mode=0o700,exist_ok=True)
    with open(CACHE+'/lock','a') as lock,open(CONFIG+'.lock','a') as config_lock:
        fcntl.flock(lock,fcntl.LOCK_EX);fcntl.flock(config_lock,fcntl.LOCK_EX)
        value=catalog()
        if value.get('state')=='running':raise ValueError('Template synchronization is running')
        row=next((row for row in value['templates'] if row['key']==key),None)
        if not row:raise ValueError('Unknown template')
        settings=cfg();root=Path(settings['_provision']['source_root'])/'minecraft'
        parts=[row.get('type',''),row.get('version',''),row.get('build','')]
        if any(not re.fullmatch(r'[A-Za-z0-9._-]{1,100}',part) or part in ('.','..') for part in parts):raise ValueError('Invalid template path')
        target=root.joinpath(*parts)
