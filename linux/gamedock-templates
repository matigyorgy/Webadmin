                env.update({k:v for k,v in os.environ.items() if k.lower() in ('http_proxy','https_proxy','no_proxy','ssl_cert_file')})
                subprocess.run(['/usr/bin/python3','-I',SELF,'build',payload,str(stage),java],preexec_fn=rt.drop(account),env=env,check=True,timeout=8000)
                for directory,dirs,files in os.walk(stage/'template',followlinks=False):
                    if any(Path(directory,name).is_symlink() for name in dirs+files):raise ValueError('Template contains symlink')
