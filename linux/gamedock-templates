    if kind not in providers:raise ValueError('Unknown Minecraft type')
    os.makedirs(CACHE,mode=0o700,exist_ok=True);path=Path(CACHE)/('releases-'+kind+'.json')
    if path.exists() and time.time()-path.stat().st_mtime<600:value=json.loads(path.read_text())
