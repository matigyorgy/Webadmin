#!/usr/bin/python3
"""Install root-owned at /usr/local/sbin/gamedock-console; never setuid."""
import base64
import json
import os
import pwd
import re
import stat
import subprocess
import sys

CONFIG = '/etc/gamedock/servers.json'

def execute(argv):
    if len(argv) not in (3, 4):
        raise ValueError('Invalid arguments')
    unit, action = argv[1:3]
    if not re.fullmatch(r'[A-Za-z0-9_-]+\.service', unit):
        raise ValueError('Invalid unit')
    info = os.stat(CONFIG)
    if info.st_uid != 0 or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        raise ValueError('Configuration must be root-owned and not writable by group/others')
    with open(CONFIG, encoding='utf-8') as stream:
        servers = json.load(stream)
    if unit not in servers:
        raise ValueError('Unit not allowed')
    server = servers[unit]
    if action == 'logs' and len(argv) == 3:
        # No pager, terminal interpretation or unrestricted journal access.
        result = subprocess.run(['/usr/bin/journalctl', '--unit='+unit, '--lines=150', '--no-pager', '--output=cat'], capture_output=True, timeout=8)
        if result.returncode:
            raise ValueError('Journal query failed')
        sys.stdout.write(result.stdout[-131072:].decode('utf-8', errors='replace'))
    elif action == 'command' and len(argv) == 4:
        command = base64.b64decode(argv[3], validate=True).decode('utf-8')
        if not command.strip() or len(command.encode()) > 500 or any(ord(c)<32 or ord(c)==127 for c in command):
            raise ValueError('Invalid console command')
        user, target = server['user'], server['tmux_target']
        if not re.fullmatch(r'[a-z_][a-z0-9_-]*', user) or pwd.getpwnam(user).pw_uid == 0:
            raise ValueError('Non-root game user required')
        if not re.fullmatch(r'[A-Za-z0-9_-]+:0\.0', target):
            raise ValueError('Explicit tmux pane required')
        prefix = ['/usr/sbin/runuser', '-u', user, '--', '/usr/bin/tmux', '-L', 'gamedock']
        # Literal mode and no shell: user text cannot become Linux commands.
        subprocess.run(prefix + ['send-keys', '-t', target, '-l', '--', command], check=True, timeout=5)
        subprocess.run(prefix + ['send-keys', '-t', target, 'Enter'], check=True, timeout=5)
        print('Console input delivered')
    else:
        raise ValueError('Action not allowed')

if __name__ == '__main__':
    try:
        execute(sys.argv)
    except (ValueError, KeyError, OSError, subprocess.SubprocessError) as exc:
        print('Console operation failed', file=sys.stderr)
        sys.exit(1)
