<!doctype html>
<html lang="hu" data-bs-theme="light">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#4079a6"><title>{block name=title}VGH.HU | Webadmin{/block}</title><link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css"><link rel="stylesheet" href="/style.css?v={$asset_version}"><script src="/panel.js?v={$asset_version}" defer></script></head>
<body>
<header class="app-topbar"><a class="app-brand" href="/">VGH.HU | Webadmin</a>{if $user}<div class="topbar-account"><span>Ügyfél azonosító: <strong>{$user.id|default:'—'}</strong></span><span class="topbar-email">{$user.email}</span><form method="post" action="/">{include file='partials/csrf.tpl'}<button class="btn btn-sm btn-light" name="action" value="logout">↪ Kilépés</button></form></div>{/if}</header>
<div class="app-shell {if !$user}guest-shell{/if}">
{if $user}<aside class="app-sidebar"><p class="sidebar-label">NAVIGÁCIÓ</p><nav class="sidebar-nav" aria-label="Főmenü"><a href="/" class="{if ($page|default:'') == 'servers' && !($selected|default:null)}is-active{/if}">{include file='partials/icon.tpl' icon='servers'}Kezdőlap</a></nav>
<p class="sidebar-label">SZERVEREK</p><nav class="server-navigation" aria-label="Játékszerverek">{foreach $navigation_groups|default:[] as $group}<details class="server-group" open><summary>{include file='partials/icon.tpl' icon='node'}<span>{$group.name}</span><small>{$group.servers|count} db</small></summary><div class="server-group-items">{foreach $group.servers as $instance}<a href="/?server={$instance.id}" class="{if ($selected.id|default:0) == $instance.id}is-active{/if}"{if ($selected.id|default:0) == $instance.id} aria-current="page"{/if}><span>{$instance.name}</span><small>{$instance.address}</small></a>{/foreach}</div></details>{foreachelse}<a class="sidebar-empty" href="/">Saját szervereim</a>{/foreach}</nav>
<nav class="sidebar-nav account-navigation" aria-label="Fiók"><a href="/?page=history" class="{if ($page|default:'') == 'history'}is-active{/if}">{include file='partials/icon.tpl' icon='clock'}Előzmények</a><a href="/?page=account" class="{if ($page|default:'') == 'account'}is-active{/if}">{include file='partials/icon.tpl' icon='user'}Saját fiók</a></nav>
{if $user.is_admin}<p class="sidebar-label">ADMINISZTRÁCIÓ</p><nav class="sidebar-nav" aria-label="Adminisztráció"><a href="/admin.php?section=games" class="{if ($section|default:'') == 'games'}is-active{/if}">{include file='partials/icon.tpl' icon='servers'}Játéktípusok</a><a href="/admin.php?section=templates" class="{if ($section|default:'') == 'templates'}is-active{/if}">{include file='partials/icon.tpl' icon='node'}Minecraft-templatek</a><a href="/admin.php?section=servers" class="{if ($section|default:'') == 'servers'}is-active{/if}">{include file='partials/icon.tpl' icon='servers'}Játékszerverek</a><a href="/admin.php?section=nodes" class="{if ($section|default:'') == 'nodes'}is-active{/if}">{include file='partials/icon.tpl' icon='node'}Linux-gépek</a><a href="/admin.php?section=users" class="{if ($section|default:'') == 'users'}is-active{/if}">{include file='partials/icon.tpl' icon='users'}Felhasználók</a><a href="/admin.php?section=audit" class="{if ($section|default:'') == 'audit'}is-active{/if}">{include file='partials/icon.tpl' icon='audit'}Műveleti napló</a><a href="/api_settings.php" class="{if ($page|default:'') == 'api'}is-active{/if}">{include file='partials/icon.tpl' icon='settings'}API-hozzáférés</a><a href="/admin.php?section=setup" class="{if ($section|default:'') == 'setup'}is-active{/if}">{include file='partials/icon.tpl' icon='settings'}Linux-beállítások</a></nav>{/if}</aside>{/if}
<div class="app-main"><main class="app-content">{block name=content}{/block}</main></div></div>
<footer class="app-footer">VGH.HU · Webadmin</footer>
</body></html>
