{extends file='layout.tpl'}
{block name=title}GameDock · Adminisztráció{/block}
{block name=content}
{assign var=titles value=['servers'=>'Játékszerverek','games'=>'Játéktípusok','templates'=>'Minecraft-templatek','nodes'=>'Linux-gépek','users'=>'Felhasználók','audit'=>'Műveleti napló','setup'=>'SSH és Linux-beállítások']}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><span class="brand-label text-success">ADMINISZTRÁCIÓ</span><h2 class="h3 mt-2 mb-0">{$titles[$section]}</h2></div>{if $section == 'servers' || $section == 'nodes' || $section == 'users' || $section == 'games'}<a class="btn btn-success" href="/admin.php?section={$section}&new=1">+ Új hozzáadása</a>{/if}</div>
<nav class="nav nav-pills flex-wrap gap-2 border-bottom pb-3 mb-4" aria-label="Adminmenü">{foreach $titles as $key=>$label}<a class="nav-link {if $section == $key}active{/if}" href="/admin.php?section={$key}">{$label}</a>{/foreach}</nav>
{if $error}<div class="alert alert-danger" role="alert">{$error}</div>{/if}{if $notice}<div class="alert alert-success" role="status">{$notice}</div>{/if}
{if $section == 'servers' && !$provision_supported}
<div class="alert alert-info"><p>A meglévő szerverek továbbra is működnek. Az új indítóparancs- és fájlmásolási funkciókhoz adatbázisfrissítés szükséges.</p><form method="post" action="/admin.php?section=servers">{include file='partials/csrf.tpl'}<button class="btn btn-primary" name="action" value="upgrade_startup">Új szerverfunkciók engedélyezése</button></form></div>
{/if}
{if $record}
{if $section == 'servers' && $record.provision_job}<section class="card rounded-4 mb-4" data-provision-admin="{$record.id}"><div class="card-body p-4"><span class="brand-label text-success">FÁJLOK TELEPÍTÉSE</span><h3 class="h5 mt-2">Másolás állapota: <span data-provision-state>{$record.provision_state}</span></h3><p data-provision-message class="text-body-secondary">{$record.provision_message|default:'A másolási állapot ellenőrizhető. A meglévő célmappát nem írjuk felül.'}</p><div class="d-flex flex-wrap gap-2"><form method="post" action="/admin.php?section=servers">{include file='partials/csrf.tpl'}<input type="hidden" name="id" value="{$record.id}"><button class="btn btn-outline-info" name="action" value="provision_status">Állapot frissítése</button></form>{if $record.provision_state != 'ready'}<form method="post" action="/admin.php?section=servers">{include file='partials/csrf.tpl'}<input type="hidden" name="id" value="{$record.id}"><button class="btn btn-outline-warning" name="action" value="provision_retry">Másolási kérés újrapróbálása</button></form>{/if}</div></div></section>{/if}
<section class="card rounded-4 mb-4"><div class="card-body p-4"><h3 class="h4 mb-4">{if $record.id}Bejegyzés szerkesztése #{$record.id}{else}Új bejegyzés{/if}</h3><form method="post" action="/admin.php?section={$section}" class="row g-3">{include file='partials/csrf.tpl'}<input type="hidden" name="id" value="{$record.id}"><input type="hidden" name="action" value="save">
{if $section == 'games'}{include file='admin/game-form.tpl'}{elseif $section == 'users'}{include file='admin/user-form.tpl'}{elseif $section == 'nodes'}{include file='admin/node-form.tpl'}{elseif $section == 'servers'}{include file='admin/server-form.tpl'}{/if}
<div class="col-12 d-flex gap-2"><button class="btn btn-success">Mentés</button><a class="btn btn-outline-secondary" href="/admin.php?section={$section}">Mégse</a></div></form></div></section>
{if $record.id || $record.existing_slug}<section class="card border-danger rounded-4 mb-4"><div class="card-body p-4"><h3 class="h5">{if $section == 'servers'}Szerver kivétele a panelből{else}Bejegyzés törlése{/if}</h3><p class="text-body-secondary">{if $section == 'servers'}Ez kizárólag a panel nyilvántartásából töröl. Nem állítja le a játékot és nem töröl fájlokat a Linux-gépről.{elseif $section == 'users'}Saját fiók nem törölhető. A felhasználó szervereit előbb rendeld más tulajdonoshoz.{else}Csak olyan Linux-gép törölhető, amelyhez nincs szerver rendelve.{/if}</p><form method="post" action="/admin.php?section={$section}">{include file='partials/csrf.tpl'}<input type="hidden" name="id" value="{$record.id}"><input type="hidden" name="slug" value="{$record.slug}"><div class="form-check mb-3"><input class="form-check-input" type="checkbox" name="confirm" id="delete-confirm" value="1" required><label class="form-check-label" for="delete-confirm">Megerősítem a bejegyzés törlését.</label></div><button class="btn btn-outline-danger" name="action" value="delete">Törlés a panelből</button></form></div></section>{/if}
{/if}
{if $section == 'templates'}{include file='admin/templates.tpl'}{elseif $section == 'setup'}{include file='admin/setup.tpl'}{elseif $section == 'audit'}{include file='admin/audit.tpl'}{else}{include file='admin/list.tpl'}{/if}
{/block}
