<p class="text-body-secondary">Az utolsó 200 esemény. A konzolparancsok szövegét nem mentjük, mert titkot tartalmazhatnak.</p>
<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Időpont</th><th>Felhasználó</th><th>Szerver</th><th>Művelet</th><th>Eredmény</th></tr></thead><tbody>{foreach $rows as $row}<tr><td class="text-nowrap">{$row.created_at_label|default:'—'}</td><td>{$row.email|default:'Törölt fiók'} #{$row.user_id}</td><td>{$row.server_name|default:'Rendszergazdai vagy fiókművelet'} #{$row.server_id}</td><td>{$row.action_label|default:'Egyéb művelet'}</td><td><span class="badge {if $row.outcome == 'accepted'}text-bg-success{elseif $row.outcome == 'failed'}text-bg-danger{else}text-bg-secondary{/if}">{$row.outcome_label|default:'Ismeretlen eredmény'}</span></td></tr>{foreachelse}<tr><td colspan="5">Még nincs esemény.</td></tr>{/foreach}</tbody></table></div>
