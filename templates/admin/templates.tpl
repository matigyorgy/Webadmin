<section class="card mb-4"><div class="card-body"><h3 class="h5">Minecraft · típusonként az utolsó 10 stabil verzió</h3><p class="text-body-secondary">Vanilla, Paper, Forge, Bukkit, Spigot, Purpur és Fabric. A letöltés/fordítás a kiválasztott Linux-gépen háttérben fut; Bukkitnál BuildTools, Forge-nál installer fut, külön korlátozott felhasználóval.</p><form method="get" class="d-flex gap-2"><input type="hidden" name="section" value="templates"><select class="form-select" name="node" required><option value="">Válassz Linux-gépet</option>{foreach $nodes as $node}<option value="{$node.id}"{if $selected_node == $node.id} selected{/if}>{$node.name}</option>{/foreach}</select><button class="btn btn-outline-secondary">Megnyitás</button></form>{if $selected_node}<div class="mt-3"><a class="btn btn-outline-info" href="/admin.php?section=nodes&edit={$selected_node}#node-setup">Linux telepítés / javítás megnyitása</a></div><form class="mt-3" method="post" action="/admin.php?section=templates">{include file='partials/csrf.tpl'}<input type="hidden" name="node_id" value="{$selected_node}"><button class="btn btn-success" name="action" value="sync">Legutóbbi 10 verzió letöltése / frissítése</button></form>{/if}</div></section>
{if $selected_node}<section data-template-node="{$selected_node}" data-csrf="{$csrf}"><p class="alert alert-info" data-template-message>{$catalog.message|default:'Még nincs szinkronizált katalógus.'}</p><div class="table-responsive"><table class="table"><thead><tr><th>Típus</th><th>Minecraft-verzió</th><th>Kiadás/build</th><th>Állapot</th><th>Részletek</th><th>Művelet</th></tr></thead><tbody>{foreach $catalog.templates as $entry}<tr><td>{$entry.type}</td><td>{$entry.version}</td><td>{$entry.build|default:''}</td><td>{$entry.state}</td><td>{$entry.message|default:''}</td><td>{if $catalog.state != 'running'}<form method="post" action="/admin.php?section=templates&amp;node={$selected_node}">{include file='partials/csrf.tpl'}<input type="hidden" name="node_id" value="{$selected_node}"><input type="hidden" name="template_key" value="{$entry.key}"><button class="btn btn-sm btn-outline-danger" name="action" value="delete_template">Törlés</button></form>{/if}</td></tr>{foreachelse}<tr><td colspan="6">Indítsd el a szinkronizálást. Csak a kész template választható szerver létrehozásakor.</td></tr>{/foreach}</tbody></table></div></section>{/if}
