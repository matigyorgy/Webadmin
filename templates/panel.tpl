{extends file='layout.tpl'}
{block name=content}
{if $error}<div class="alert alert-danger" role="alert">{$error}</div>{/if}
{if $notice}<div class="alert alert-success" role="status">{$notice}</div>{/if}
{if !$user}
<div class="row justify-content-center py-4 py-md-5"><div class="col-12 col-md-8 col-lg-5"><section class="card rounded-4 shadow-sm"><div class="card-body p-4 p-md-5"><h2 class="h3 fw-bold">Üdv újra!</h2><p class="text-body-secondary mb-4">Jelentkezz be a szervereid kezeléséhez.</p><form method="post" action="/">{include file='partials/csrf.tpl'}<div class="mb-3"><label class="form-label" for="email">E-mail</label><input class="form-control form-control-lg" id="email" type="email" name="email" autocomplete="username" required maxlength="190"></div><div class="mb-4"><label class="form-label" for="password">Jelszó</label><input class="form-control form-control-lg" id="password" type="password" name="password" autocomplete="current-password" required></div><button name="action" value="login" class="btn btn-success btn-lg w-100">Bejelentkezés →</button></form></div></section></div></div>
{elseif $page == 'account'}
<section class="card rounded-4"><div class="card-body p-4"><h2 class="h3">Saját fiók</h2><p class="text-body-secondary">Az adatok módosításához add meg a jelenlegi jelszavadat. Az új jelszó mezőit hagyd üresen, ha csak az e-mail-címet módosítod.</p><form method="post" action="/?page=account" class="row g-3">{include file='partials/csrf.tpl'}<input type="hidden" name="action" value="account"><div class="col-12"><label class="form-label" for="account-email">E-mail</label><input class="form-control" id="account-email" name="email" type="email" maxlength="190" value="{$user.email}" required></div><div class="col-12"><label class="form-label" for="current-password">Jelenlegi jelszó</label><input class="form-control" id="current-password" name="current_password" type="password" autocomplete="current-password" required></div><div class="col-md-6"><label class="form-label" for="new-password">Új jelszó (12–72 bájt)</label><input class="form-control" id="new-password" name="new_password" type="password" autocomplete="new-password" minlength="12" maxlength="72"></div><div class="col-md-6"><label class="form-label" for="password-confirm">Új jelszó még egyszer</label><input class="form-control" id="password-confirm" name="password_confirm" type="password" autocomplete="new-password" minlength="12" maxlength="72"></div><div class="col-12"><button class="btn btn-success">Fiókadatok mentése</button></div></form></div></section>
{elseif $page == 'history'}
<h2 class="h3 mb-4">Műveleti előzmények</h2>{include file='partials/history.tpl'}
{else}
{if $selected}
<div class="d-flex flex-wrap justify-content-between gap-3 align-items-start mb-4"><div><a href="/" class="link-success">← Vissza a szerverekhez</a><h2 class="h3 mt-3">{$selected.name}</h2><p class="text-body-secondary">{$selected.game_name} · {$selected.node_name}</p><span id="server-state" class="badge text-bg-secondary">{if $selected.provision_state|default:'ready' != 'ready'}Telepítés: {$selected.provision_state}{else}nincs lekérdezve{/if}</span></div><form method="post" action="/?server={$selected.id}" class="d-flex flex-wrap gap-2">{include file='partials/csrf.tpl'}<input type="hidden" name="server_id" value="{$selected.id}"><button class="btn btn-success" name="action" value="start"{if $selected.provision_state|default:'ready' != 'ready'} disabled{/if}>Indítás</button><button class="btn btn-outline-warning" name="action" value="restart"{if $selected.provision_state|default:'ready' != 'ready'} disabled{/if}>Újraindítás</button><button class="btn btn-outline-danger" name="action" value="stop"{if $selected.provision_state|default:'ready' != 'ready'} disabled{/if}>Leállítás</button><button class="btn btn-outline-secondary" name="action" value="status">Állapot</button></form></div>
{if $selected.provision_state|default:'ready' != 'ready'}<div class="alert alert-info" data-provision-client="{$selected.id}"><strong>Szerverfájlok előkészítése</strong><p class="mb-0" data-provision-message>A szerver a másolás sikeres befejezése után indítható. Az állapot automatikusan frissül.</p><span data-provision-state>{$selected.provision_state}</span></div>{/if}
{else}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><h2 class="h4 mb-0">{if $user.is_admin}Összes szerver{else}Saját szervereim{/if} <span class="badge text-bg-secondary rounded-pill ms-2">{$server_count}</span></h2>{if $user.is_admin}<a class="btn btn-success" href="/admin.php?section=servers&new=1">+ Szerver hozzáadása</a>{/if}</div>
<form method="get" class="d-flex gap-2 mb-4"><label class="visually-hidden" for="search">Szerver keresése</label><input class="form-control" id="search" name="q" value="{$search}" placeholder="Keresés szervernév, játék vagy gép alapján" maxlength="100"><button class="btn btn-outline-secondary">Keresés</button></form>
<div class="row g-4">{foreach $servers as $server}<div class="col-12 col-md-6 col-xl-4"><article class="card h-100 shadow-sm rounded-4"><div class="card-body p-4 d-flex flex-column"><div class="d-flex justify-content-between align-items-start gap-2 mb-4"><span class="small text-success fw-semibold">{$server.game_name}</span><span id="state-{$server.id}" class="badge text-bg-secondary">{$server.state}</span></div><h3 class="h4 text-break">{$server.name}</h3>{if $server.provision_state|default:'ready' != 'ready'}<p class="small text-info">Fájlmásolás: {$server.provision_state}</p>{/if}<p class="text-body-secondary mb-4">{$server.node_name}</p><div class="d-flex flex-wrap gap-2 mt-auto"><a class="btn btn-success" href="/?server={$server.id}">Kezelés és konzol</a><button type="button" class="btn btn-outline-secondary" data-status-id="{$server.id}">Állapot</button></div></div></article></div>{/foreach}</div>
{if !$servers}<section class="card rounded-4 text-center"><div class="card-body py-5 px-4"><h2 class="h4">Még nincs hozzárendelt szerver.</h2><p class="text-body-secondary">Az adminisztrátor rendelhet játékszervereket a fiókodhoz.</p>{if $user.is_admin}<a class="btn btn-success" href="/admin.php?section=servers&new=1">Első szerver hozzáadása</a>{/if}</div></section>{/if}
{/if}
{if $console}
<section class="card rounded-4 mt-4" id="console" data-server-id="{$console.id}" aria-labelledby="console-title"><div class="card-body p-4"><div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3"><h2 id="console-title" class="h4 mb-0">Konzol · {$console.name}</h2><div class="d-flex align-items-center gap-3"><div class="form-check form-switch"><input class="form-check-input" id="auto-refresh" type="checkbox"><label class="form-check-label small" for="auto-refresh">Automatikus frissítés (5 mp)</label></div><button type="button" class="btn btn-outline-info" id="refresh-console">Frissítés</button></div></div><p class="small text-body-secondary" id="console-feedback" role="status">Az utolsó 150 naplósor jelenik meg.</p><pre id="console-output" class="console-output bg-black text-light p-3 rounded" tabindex="0" aria-label="Szervernapló">{$console.logs}</pre><form method="post" action="/?server={$console.id}" class="row g-2 align-items-end">{include file='partials/csrf.tpl'}<input type="hidden" name="server_id" value="{$console.id}"><div class="col-12 col-md"><label class="form-label" for="console-command">Játékkonzol-parancs</label><input id="console-command" class="form-control font-monospace" name="command" required maxlength="500" autocomplete="off"></div><div class="col-12 col-md-auto"><button class="btn btn-success" name="action" value="command">Küldés</button></div><p class="small text-body-secondary mb-0">Egy játékparancs, egy sorban, legfeljebb 500 bájt. Például: list vagy status.</p></form><noscript><form class="mt-3" method="post" action="/?server={$console.id}">{include file='partials/csrf.tpl'}<input type="hidden" name="server_id" value="{$console.id}"><button class="btn btn-outline-info" name="action" value="logs">Napló lekérdezése</button></form></noscript></div></section>
{/if}
{if $selected}<h3 class="h5 mt-4">A szerver legutóbbi műveletei</h3>{include file='partials/history.tpl'}{/if}
{/if}
{/block}
