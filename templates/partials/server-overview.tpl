<div class="server-heading"><div><h2{if $selected.minecraft_type|default:''} data-platform-version{/if}>{if $selected.minecraft_type|default:''}{$selected.minecraft_type|capitalize} {$selected.minecraft_version}{else}{$selected.name}{/if}</h2><span class="heading-subtitle">{$selected.name} · {$selected.game_name}</span></div><form method="post" action="/?server={$selected.id}" id="server-controls" class="power-controls">{include file='partials/csrf.tpl'}<input type="hidden" name="server_id" value="{$selected.id}"><button class="power-button power-start" name="action" value="start"{if $selected.provision_state|default:'ready' != 'ready'} disabled{/if}><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6 3.8a1 1 0 0 1 1.5-.9l13 8.2a1 1 0 0 1 0 1.8l-13 8.2a1 1 0 0 1-1.5-.9z"/></svg><span>Indítás</span></button><button class="power-button power-restart" name="action" value="restart"{if $selected.provision_state|default:'ready' != 'ready'} disabled{/if}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M19 8a9 9 0 1 1-7-4h6M15 1l4 3-4 4"/></svg><span>Újraindítás</span></button><button class="power-button power-stop" name="action" value="stop"{if $selected.provision_state|default:'ready' != 'ready'} disabled{/if}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2" fill="currentColor"/></svg><span>Leállítás</span></button></form></div>
<p id="control-feedback" class="small text-body-secondary" role="status" aria-live="polite"></p>
<div class="server-summary"><div class="summary-tile"><span>IP / Port</span><strong>{$selected.address|default:'nincs beállítva'}{if $selected.port|default:null}:{$selected.port}{/if}</strong></div><div class="summary-tile"><span>Verzió / Játék</span><strong data-platform-version>{if $selected.minecraft_type|default:''}{$selected.minecraft_type|capitalize} {$selected.minecraft_version}{else}{$selected.game_name}{/if}</strong></div><div class="summary-tile"><span>Linux-gép</span><strong>{$selected.node_name}</strong></div></div>
<div class="server-dashboard"><section class="dashboard-panel" id="server-resources" data-server-id="{$selected.id}" data-memory-limit="{$selected.memory_limit_mb|default:0}" data-disk-limit="{$selected.disk_limit_mb|default:0}"><h3>Szerver áttekintés</h3><div class="overview-facts"><div><strong>Állapot</strong><span id="server-state" class="badge text-bg-secondary">{if $selected.provision_state|default:'ready' != 'ready'}Telepítés: {$selected.provision_state}{else}nincs lekérdezve{/if}</span></div><div><strong>IP / Port</strong><span>{$selected.address|default:'nincs beállítva'}{if $selected.port|default:null}:{$selected.port}{/if}</span></div><div><strong>Játék</strong><span>{$selected.game_name}</span></div></div>
<div class="resource-meter"><div class="meter-label"><span>CPU</span><strong data-cpu>—</strong></div><div class="progress" role="progressbar" aria-label="CPU-használat" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-cpu-progress><div class="progress-bar" style="width:0%"></div></div></div>
<div class="resource-meter"><div class="meter-label"><span>Memória</span><strong data-memory>—</strong></div><div class="progress" role="progressbar" aria-label="Memóriahasználat" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-memory-progress><div class="progress-bar" style="width:0%"></div></div></div>
<div class="resource-meter"><div class="meter-label"><span>Foglalt tárhely</span><strong data-disk>Mérés folyamatban…</strong></div><div class="progress" role="progressbar" aria-label="Tárhelyhasználat" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-disk-progress><div class="progress-bar" style="width:0%"></div></div><p class="small mt-1 mb-0" data-disk-message role="status"></p></div>
<div class="overview-facts overview-details"><div><strong>Node</strong><span>{$selected.node_name}</span></div><div><strong>Platform</strong><span data-platform-version>{if $selected.minecraft_type|default:''}{$selected.minecraft_type|capitalize} {$selected.minecraft_version}{else}{$selected.game_name}{/if}</span></div><div><strong>Memória</strong><span>{if $selected.memory_limit_mb|default:0}{$selected.memory_limit_mb} MiB{else}Korlátlan{/if}</span></div><div><strong>Tárhelykeret</strong><span data-disk-limit>{if $selected.disk_limit_mb|default:0}{$selected.disk_limit_mb} MiB{else}Korlátlan{/if}</span></div>{if $selected.expires_at|default:0}<div><strong>Lejárat</strong><span>{$selected.expires_at|date_format:'%d.%m.%Y %H:%M'}</span></div>{/if}<div><strong>Szerver ID</strong><span>#{$selected.id}</span></div><div><strong>Állapotfrissítés</strong><span>Automatikusan, 5 mp</span></div><div><strong>Fájlok</strong><span>{if $selected.provision_state|default:'ready' == 'ready'}Telepítve{else}{$selected.provision_state}{/if}</span></div></div><p class="resource-feedback" data-resource-message>Élő adatok betöltése…</p></section>
<aside class="dashboard-panel server-tools"><h3>Eszközök</h3><nav aria-label="Szervereszközök"><a href="#console">{include file='partials/icon.tpl' icon='servers'}Konzol</a>{if $selected.provision_state|default:'ready' == 'ready'}<a href="#ftp-access">{include file='partials/icon.tpl' icon='node'}FTP-hozzáférés</a><a href="#scheduler">{include file='partials/icon.tpl' icon='clock'}Időzítő</a><a href="#backups">{include file='partials/icon.tpl' icon='audit'}Biztonsági mentés</a><a href="#version-switch">{include file='partials/icon.tpl' icon='node'}Verzióváltás</a>{/if}<button type="submit" form="server-controls" name="action" value="status">{include file='partials/icon.tpl' icon='clock'}Állapot frissítése</button><a href="#server-history">{include file='partials/icon.tpl' icon='audit'}Naplózás</a>{if $user.is_admin}<a href="/admin.php?section=servers&edit={$selected.id}">{include file='partials/icon.tpl' icon='settings'}Szerverbeállítások</a>{/if}<a href="/">{include file='partials/icon.tpl' icon='servers'}Összes szerver</a></nav></aside></div>
