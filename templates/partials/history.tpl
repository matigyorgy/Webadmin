<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Időpont</th><th>Szerver</th><th>Művelet</th><th>Eredmény</th></tr></thead><tbody>{foreach $history as $event}<tr><td class="text-nowrap">{$event.created_at_label|default:'—'}</td><td>{$event.server_name|default:'Fiók / törölt szerver'}</td><td>{$event.action_label|default:'Egyéb művelet'}</td><td><span class="badge {if $event.outcome == 'accepted'}text-bg-success{elseif $event.outcome == 'failed'}text-bg-danger{else}text-bg-secondary{/if}">{$event.outcome_label|default:'Ismeretlen eredmény'}</span></td></tr>{foreachelse}<tr><td colspan="4" class="text-body-secondary">Még nincs művelet.</td></tr>{/foreach}</tbody></table></div>
