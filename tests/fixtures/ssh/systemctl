#!/usr/bin/python3
"""Test-only substitute. Never install this on production Linux."""
import json,os,signal,subprocess,sys
from pathlib import Path
args=sys.argv[1:];action=args[0]
unit=next((value for value in args[1:] if value.endswith('.service')),'minecraft.service')
folder=Path('/var/lib/gamedock-fixture/units');folder.mkdir(exist_ok=True)
file=folder/unit
if unit=='minecraft.service':
    state=Path('/var/lib/gamedock-fixture/state')
    if action=='show':
        values={'LoadState':'loaded','Transient':'no','ActiveState':state.read_text().strip()}
    elif action in ('start','restart'):
        subprocess.run(['/usr/sbin/runuser','-u','minecraft','--','/usr/bin/tmux','-L','gamedock','kill-session','-t','minecraft-survival'],capture_output=True)
        subprocess.run(['/usr/sbin/runuser','-u','minecraft','--','/usr/bin/tmux','-L','gamedock','new-session','-d','-s','minecraft-survival','--','/usr/bin/python3','/opt/fixture/game.py'],check=True)
        subprocess.run(['/usr/sbin/runuser','-u','minecraft','--','/usr/bin/tmux','-L','gamedock','pipe-pane','-t','minecraft-survival:0.0','cat >> /home/minecraft/game.log'],check=True)
        state.write_text('active\n');sys.exit(0)
    elif action=='stop':
        subprocess.run(['/usr/sbin/runuser','-u','minecraft','--','/usr/bin/tmux','-L','gamedock','kill-session','-t','minecraft-survival'],capture_output=True)
        state.write_text('inactive\n');sys.exit(0)
else:
    values={'LoadState':'not-found','Transient':'no','ActiveState':'inactive'}
    if file.exists():
        data=json.loads(file.read_text());pid=data['pid']
        try:alive=Path('/proc/'+str(pid)+'/stat').read_text().split()[2]!='Z'
        except FileNotFoundError:alive=False
        if alive:values={'LoadState':'loaded','Transient':'yes','ActiveState':'active'}
        elif os.geteuid()==0:file.unlink(missing_ok=True)
    if action=='stop' and file.exists():
        parent=json.loads(file.read_text())['pid'];descendants={parent}
        processes={}
        for entry in Path('/proc').iterdir():
            if entry.name.isdigit():
                try:processes[int(entry.name)]=int((entry/'stat').read_text().split()[3])
                except (OSError,ValueError):pass
        for _ in range(10):
            descendants.update(pid for pid,ppid in processes.items() if ppid in descendants)
        for pid in sorted(descendants,reverse=True):
            try:os.kill(pid,signal.SIGTERM)
            except ProcessLookupError:pass
        file.unlink(missing_ok=True);sys.exit(0)
if action!='show':sys.exit(1)
properties=[arg.split('=',1)[1] for arg in args if arg.startswith('--property=')]
for name in properties or values:
    print(values.get(name,'') if '--value' in args else name+'='+values.get(name,''))
