#!/usr/bin/python3
"""Test-only systemd-run substitute using real dropped-UID subprocesses."""
import json,os,pwd,subprocess,sys
from pathlib import Path
args=sys.argv[1:];command=next(i for i,arg in enumerate(args) if not arg.startswith('--'))
options={arg.split('=',1)[0]:arg.split('=',1)[1] for arg in args[:command] if '=' in arg}
unit=options['--unit'];folder=Path('/var/lib/gamedock-fixture/units');folder.mkdir(exist_ok=True)
output=open(folder/(unit+'.log'),'ab')
uid=pwd.getpwnam(options['--uid']).pw_uid if '--uid' in options else 0
gid=int(options.get('--gid','0'))
def drop():
    if uid:os.setgroups([]);os.setgid(gid);os.setuid(uid)
process=subprocess.Popen(args[command:],cwd=options.get('--working-directory','/'),stdout=output,stderr=subprocess.STDOUT,start_new_session=True,preexec_fn=drop)
(folder/unit).write_text(json.dumps({'pid':process.pid}))
output.close();print('Test service launched')
